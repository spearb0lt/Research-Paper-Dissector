# Copy to .env and fill in whatever you have. Every value is optional.
#
# With no keys at all the app is fully usable: it parses PDFs, extracts figures,
# tables, formulas and references, builds a keyword index and a local vector
# index, and answers "where in this paper is X" exactly. Adding one LLM key
# adds written, cited answers and the analysis lenses on top of that.

# ---------------------------------------------------------------- essentials

APP_NAME=Dissect
# Set this on a hosted deployment so generated links are absolute. Vercel sets
# VERCEL_URL automatically, which is used as a fallback.
PUBLIC_BASE_URL=

# Storage. Leave DATABASE_URL empty to use SQLite on the local filesystem.
# On Vercel the filesystem is ephemeral, so a Postgres URL is required there:
# Neon and Supabase both have a free tier that is ample.
DATABASE_URL=
DATA_DIR=./data

# Optional password on the whole API, sent by the browser as X-App-Password.
APP_PASSWORD=

# Let visitors paste their own provider keys in the UI. On, a public deployment
# costs you nothing because each visitor spends their own quota. A key pasted
# this way is held for the lifetime of one request and never stored.
ALLOW_CLIENT_KEYS=1

# ------------------------------------------------------------- LLM providers
# You need at most one, and only for written answers. Gemini, Groq, Cerebras
# and Cloudflare all have a usable free tier. Ollama needs no key at all.

GOOGLE_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
SAMBANOVA_API_KEY=
FIREWORKS_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=
HUGGINGFACE_API_KEY=

# Cloudflare Workers AI needs BOTH values: the account id is part of the URL,
# so a token on its own cannot address anything.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Local model servers. Only reachable when the app runs on your own machine or
# a VM, never from a serverless deployment.
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LLAMACPP_BASE_URL=http://localhost:8080/v1
VLLM_BASE_URL=http://localhost:8000/v1

# Pin a model per provider, otherwise the picker's default is used.
GEMINI_MODEL=
GROQ_MODEL=
OPENAI_MODEL=
ANTHROPIC_MODEL=

# ---------------------------------------------------------------- embeddings
# "auto" prefers a local backend over a hosted one even when the hosted one
# scores higher, because embedding a whole paper is the one operation that can
# quietly cost money. A hosted backend is used only if you name it here or pick
# it in Settings. On a fresh install "auto" resolves to the bundled ONNX model.
#
# Named options: onnx, lexical, sentence_transformers, ollama_embed,
# gemini_embed, cloudflare_embed, jina_embed, voyage_embed, openai_embed,
# cohere_embed, hf_embed.
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
LOCAL_EMBED_ENABLED=1

JINA_API_KEY=
VOYAGE_API_KEY=
COHERE_API_KEY=

# ------------------------------------------------------------------- parsing
# "auto" uses the deep parser where the machine can run it and the fast one
# everywhere else. Options: auto, fast, deep.
PARSE_MODE=auto

# Render figures at this multiple of the PDF's own resolution. Two is enough to
# read axis labels on a single column chart without quadrupling storage.
FIGURE_SCALE=2.0
PAGE_RENDER_SCALE=1.6

# OCR over figures and scanned pages. Off by default: it is slow, and on a
# paper with a good text layer it adds nothing. It is the only way to search a
# chart's axis labels, which is often where a number actually lives.
# Engines, in order of preference: rapidocr (no system binary), easyocr,
# tesseract (needs the binary on PATH).
OCR_ENABLED=0
OCR_ENGINE=auto
OCR_LANGUAGES=en

# Docling's formula and code enrichment models. Each is a separate download.
FORMULA_ENRICHMENT=0

# ------------------------------------------------------------------ indexing

CHUNK_TOKENS=450
CHUNK_OVERLAP=80
MIN_CHUNK_CHARS=80

# The dense leg. On, and local, by default. Off leaves BM25 alone, which is
# faster to build and still answers exact value questions well.
DENSE_INDEX_ENABLED=1

# Visual search over figures with CLIP. Needs PyTorch.
CLIP_INDEX_ENABLED=0

# The LLM pass that writes a summary per element at index time. Off by default:
# it is the one indexing step that costs money, and the section context added
# to every chunk for free recovers most of what it buys.
LLM_ENRICH_ENABLED=0

# ---------------------------------------------------------------- retrieval

RETRIEVE_TOP_K=12
CANDIDATE_K=40
# Reciprocal rank fusion's damping constant. 60 is the value from the paper.
RRF_K=60

# Cross encoder reranking. The single largest quality gain available, and needs
# PyTorch, so it is a per request switch rather than a default.
RERANK_ENABLED=0
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---------------------------------------------------------------- answering

ANSWER_TEMPERATURE=0.1
ANSWER_MAX_TOKENS=4096
MEMORY_TURNS=6
VISION_ENABLED=1
MAX_VISION_IMAGES=4

DEBUG=0
